{
  "source": ["config/generated.tokens.json"],
  "platforms": {
    "css": {
      "transformGroup": "css",
      "buildPath": "build/css/",
      "files": [
        {
          "destination": "variables.css",
          "format": "css/variables",
          "options": {
            "outputReferences": true
          }
        }
      ]
    },
    "markdown": {
      "transformGroup": "web",
      "buildPath": "build/docs/",
      "files": [
        {
          "destination": "design-tokens.md",
          "format": "markdown/table"
        }
      ]
    },
    "mdx": {
      "transformGroup": "web",
      "buildPath": "build/docs/",
      "files": [
        {
          "destination": "tokens.mdx",
          "format": "mdx/custom-format"
        }
      ]
    }
  }
}
